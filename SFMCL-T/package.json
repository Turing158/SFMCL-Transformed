{
  "name": "sfmcl-t",
  "description": "StarFall Minecraft Launcher-Transformed",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:corners": "node scripts/generate-pixel-geometry.mjs",
    "check:corners": "node scripts/generate-pixel-geometry.mjs --check && node --test scripts/pixel-geometry.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:corners && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "..\\dev.cmd",
    "package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ..\\build.ps1",
    "package:installer": "npm run package -- -Mode installer",
    "package:single": "npm run package -- -Mode single",
    "package:x86": "npm run package -- -Architecture x86",
    "package:x64": "npm run package -- -Architecture x64",
    "test": "vitest run --dir src",
    "test:confirmations": "node scripts/verify-confirmations.mjs",
    "test:startup": "node scripts/verify-startup.mjs",
    "test:window-motion": "node scripts/verify-window-motion.mjs",
    "test:window-drag": "node scripts/verify-window-drag.mjs",
    "test:window-motion-native": "node scripts/verify-window-motion-native.mjs",
    "test:notices": "node scripts/verify-home-notices.mjs",
    "test:home-content": "node scripts/verify-home-content.mjs",
    "test:home-settings": "node scripts/verify-home-settings.mjs",
    "test:home-scroll": "node scripts/verify-home-scroll.mjs",
    "test:home-reorder": "node scripts/verify-home-reorder.mjs",
    "test:breadcrumbs": "node scripts/verify-breadcrumbs.mjs",
    "test:page-retention": "node scripts/verify-page-retention.mjs",
    "test:packaging": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-packaging.ps1",
    "test:controls": "node scripts/verify-pixel-controls.mjs",
    "test:memory": "node scripts/verify-memory-controls.mjs",
    "test:auto-save": "node scripts/verify-auto-save.mjs",
    "test:themes-cache": "node scripts/verify-themes-cache.mjs",
    "test:updates": "node scripts/verify-updates.mjs",
    "test:minecraft-source": "node scripts/verify-minecraft-source.mjs",
    "test:components": "node scripts/verify-pixel-components.mjs",
    "test:version-settings": "node scripts/verify-version-settings.mjs",
    "test:launch-settings": "node scripts/verify-launch-settings.mjs",
    "test:java-list": "node scripts/verify-java-list.mjs",
    "test:versions": "node scripts/verify-versions.mjs",
    "test:multiplayer": "node scripts/verify-multiplayer.mjs",
    "test:all-versions": "node scripts/verify-all-versions.mjs",
    "test:resources": "node scripts/verify-resource-center.mjs",
    "test:modpacks": "node scripts/verify-modpacks.mjs",
    "test:modpack-drop": "node scripts/verify-modpack-drop.mjs",
    "test:datapack-desktop": "node scripts/verify-datapack-desktop.mjs",
    "test:resource-file-tags": "node scripts/verify-resource-file-tags.mjs",
    "test:tooltips": "node scripts/verify-tooltips.mjs",
    "test:resource-dependency-tags": "node scripts/verify-resource-dependency-tags.mjs",
    "test:curseforge-download": "node scripts/verify-curseforge-download.mjs",
    "test:install-components": "node scripts/verify-install-components.mjs",
    "test:resource-motion": "node scripts/verify-resource-motion.mjs",
    "test:launch-dock": "node scripts/verify-launch-dock.mjs",
    "test:local-data": "node scripts/verify-local-data.mjs",
    "test:local-data-desktop": "node scripts/verify-local-data-desktop.mjs",
    "test:footer-motion": "node scripts/verify-footer-motion.mjs",
    "test:footer-text": "node scripts/verify-footer-text.mjs",
    "test:footer-settle": "node scripts/verify-footer-settle.mjs",
    "test:downloads": "node scripts/verify-downloads.mjs",
    "test:download-mining": "node scripts/verify-download-mining.mjs",
    "test:download-clear": "node scripts/verify-download-clear.mjs",
    "test:notifications": "node scripts/verify-notifications.mjs",
    "test:sidebar": "node scripts/verify-sidebar.mjs",
    "test:sidebar-progress": "node scripts/verify-sidebar-progress.mjs",
    "test:favorites": "node scripts/verify-favorites.mjs",
    "test:scrollbars": "node scripts/verify-scrollbars.mjs",
    "test:favorite-context-menu": "node scripts/verify-favorite-context-menu.mjs",
    "test:version-context-menu": "node scripts/verify-favorite-context-menu.mjs --versions",
    "test:players": "node scripts/verify-players.mjs",
    "test:player-reorder": "node scripts/verify-player-reorder.mjs",
    "test:player-refresh": "node scripts/verify-player-refresh.mjs",
    "test:player-profile": "node scripts/verify-player-profile.mjs",
    "test:player-login": "node scripts/verify-player-login.mjs",
    "test:player-login-menu": "node scripts/verify-player-login-menu.mjs",
    "test:yggdrasil": "node scripts/verify-yggdrasil.mjs",
    "test:player-login-motion": "node scripts/verify-player-login-motion.mjs",
    "test:player-motion": "node scripts/verify-player-motion.mjs",
